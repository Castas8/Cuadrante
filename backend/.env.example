# Puerto del servidor
PORT=3000

# Cadena de conexión de MongoDB Atlas (NO subas la real al repositorio)
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_URL>/cuadrante

# Llave secreta para firmar los tokens de sesión (usa un texto largo y aleatorio)
JWT_SECRET=<CAMBIA_ESTO_POR_UN_TEXTO_LARGO_Y_ALEATORIO>

# Cuánto dura la sesión antes de pedir login otra vez
JWT_EXPIRES_IN=8h

# URLs del frontend que pueden consumir la API (separadas por coma)
FRONTEND_ORIGINS=http://localhost:5173
